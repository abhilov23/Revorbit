# ─────────────────────────────────────────────────────────────
# Revorbit environment variables
# Copy to `.env` for local development and use the same keys in
# your deployment platforms (Vercel, Upstash, Neon, worker host).
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development

# Interface the API binds to. 0.0.0.0 is required in containers;
# use 127.0.0.1 to restrict to localhost.
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info

# Largest accepted request body, in bytes. Raise only if you need
# large webhook payloads.
MAX_BODY_BYTES=100000

# CORS origin for the dashboard (e.g. http://localhost:3001 locally,
# https://revorbit.vercel.app in production). No trailing slash.
CORS_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:3001

# GitHub OAuth callback URL that GitHub redirects to.
# Local: http://localhost:3000/api/v1/auth/github/callback
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/github/callback

# ── Database (Neon / Postgres) ───────────────────────────────
# Keep Postgres serverless-compatible (Neon serverless pooling).
DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require

# ── Redis (Upstash / Redis Cloud / local) ─────────────────────
# Sessions, OAuth state, rate limiting and BullMQ. Provide EITHER a
# full URL (REDIS_URL, e.g. Upstash rediss://... ) OR the connection
# parts below (Redis Cloud). Prefer TLS in production.
#   Local: localhost:6379, or REDIS_URL=redis://127.0.0.1:6379
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_TLS=false

# ── Sessions ─────────────────────────────────────────────────
# Signs the session cookie. Must be at least 16 characters; use a long
# random value and rotate it to invalidate every existing session.
SESSION_SECRET=change-me-to-a-long-random-value
SESSION_TTL_SECONDS=604800

# ── GitHub App ───────────────────────────────────────────────
# OAuth2 client (Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App installation (Settings > Developer settings > GitHub Apps)
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=

# Private key for App authentication. Provide EITHER:
#   - GITHUB_PRIVATE_KEY: the PEM contents inline (use \n for newlines;
#     on Vercel/Render, paste the full PEM as a secret)
#   - GITHUB_PRIVATE_KEY_PATH: path to a .pem file
# Relative paths resolve against the current app directory first, then
# the repository root, so both `keys/app.pem` and
# `apps/api/keys/app.pem` work.
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=apps/api/keys/revorbit.pem

# ── Email (password reset) ───────────────────────────────────
# With RESEND_API_KEY set, password-reset mail is delivered via Resend.
# Without it, development logs the message (including the reset link)
# instead of sending it. RESEND_API_KEY is REQUIRED in production.
RESEND_API_KEY=
MAIL_FROM=Revorbit <noreply@revorbit.dev>

# ── AI (OpenAI-compatible) ───────────────────────────────────
# Any OpenAI-compatible provider works.
#   OpenAI:    leave AI_BASE_URL empty
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1
#   Groq:       AI_BASE_URL=https://api.groq.com/openai/v1
#   Ollama/LM Studio: AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=your-api-key
AI_BASE_URL=
# Used by the worker, and as the default model for newly connected
# repositories. It must be a model your provider actually serves.
AI_MODEL=

# Reviews processed in parallel by the worker. Each concurrent review
# makes multiple AI API calls, so raise cautiously.
WORKER_CONCURRENCY=2

# ── Web (deployed on Vercel) ─────────────────────────────────
# Public API origin the dashboard calls. Set in the Vercel web project.
NEXT_PUBLIC_API_ORIGIN=http://localhost:3000